# AI-SecOps T1 — non-secret configuration.
# Copy to `.env` (never commit). Secrets live in ./secrets/*.txt (gitignored).

POSTGRES_DB=ai_secops
POSTGRES_USER=ai_secops

TZ=UTC

# Qdrant API key — generate: openssl rand -hex 32
QDRANT_API_KEY=

# Open WebUI session secret — generate: openssl rand -hex 48
WEBUI_SECRET_KEY=
