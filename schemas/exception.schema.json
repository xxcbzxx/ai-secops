{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-secops.dev/schemas/exception.schema.json",
  "title": "AI-SecOps governance artifact — EXCEPTION",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "id", "version", "title", "policy_ref",
               "risk_ref", "requested_by", "requested_at", "status",
               "justification", "scope", "approvers"],
  "properties": {
    "api_version": { "const": "ai-secops.gov/v1" },
    "kind": { "const": "exception" },
    "id": { "type": "string", "pattern": "^EX-[0-9]{3}$" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "minLength": 6 },
    "policy_ref": { "$ref": "#/$defs/typed_ref" },
    "risk_ref": { "$ref": "#/$defs/typed_ref" },
    "requested_by": { "$ref": "#/$defs/person" },
    "requested_at": { "$ref": "#/$defs/date" },
    "status": { "enum": ["draft", "pending_approval", "active", "expired", "revoked", "rejected"] },
    "valid_from": { "$ref": "#/$defs/date" },
    "valid_to": { "$ref": "#/$defs/date" },
    "review_before": { "$ref": "#/$defs/date" },
    "justification": { "type": "string", "minLength": 20 },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "compensating_controls": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CTL-[0-9]{3}$" }
    },
    "scope": { "$ref": "#/$defs/selector" },
    "approvers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "decision", "decided_at"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "decision": { "enum": ["approved", "rejected", "abstained", "revoked"] },
          "decided_at": { "$ref": "#/$defs/date" },
          "comment": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["active"] } } },
      "then": { "required": ["valid_from", "valid_to"] }
    }
  ],
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "typed_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environments": { "type": "array", "items": {
          "enum": ["lab", "staging", "production", "dmz", "management"] } },
        "asset_kinds": { "type": "array", "items": {
          "enum": ["host", "vm", "container", "network_device", "appliance",
                   "site", "cluster", "cloud_account", "storage", "database",
                   "application"] } },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "exposures": { "type": "array", "items": {
          "enum": ["internal", "edge_exposed", "public"] } },
        "asset_uids": { "type": "array", "items": { "type": "string" } },
        "services": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
