{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-secops.dev/schemas/standard.schema.json",
  "title": "AI-SecOps governance artifact — STANDARD",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "id", "version", "title", "state",
               "body", "summary", "controls", "owner"],
  "properties": {
    "api_version": { "const": "ai-secops.gov/v1" },
    "kind": { "const": "standard" },
    "id": { "type": "string", "pattern": "^STD-[0-9]{3}$" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "minLength": 8 },
    "state": { "enum": ["adopted", "current", "revised", "retired"] },
    "body": { "type": "string" },
    "based_on": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string", "minLength": 20 },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposures": { "type": "array", "items": {
          "enum": ["internal", "edge_exposed", "public"] } },
        "environments": { "type": "array", "items": {
          "enum": ["lab", "staging", "production", "dmz", "management"] } }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "requirement"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" },
          "title": { "type": "string" },
          "requirement": { "type": "string", "minLength": 20 },
          "mapped_policies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^POL-[0-9]{3}$" }
          },
          "evidence_hints": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "owner": { "type": "string" },
    "effective_from": { "$ref": "#/$defs/date" },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cadence", "next"],
      "properties": {
        "cadence": { "type": "string" },
        "next": { "$ref": "#/$defs/date" }
      }
    },
    "related": { "$ref": "#/$defs/related" }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policies":  { "type": "array", "items": { "type": "string" } },
        "exceptions":{ "type": "array", "items": { "type": "string" } },
        "risks":     { "type": "array", "items": { "type": "string" } },
        "standards": { "type": "array", "items": { "type": "string" } },
        "adrs":      { "type": "array", "items": { "type": "string" } },
        "controls":  { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
