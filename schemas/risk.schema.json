{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-secops.dev/schemas/risk.schema.json",
  "title": "AI-SecOps governance artifact — RISK",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "id", "version", "title", "status",
               "category", "owner", "description", "assessment", "residual",
               "appetite", "related"],
  "properties": {
    "api_version": { "const": "ai-secops.gov/v1" },
    "kind": { "const": "risk" },
    "id": { "type": "string", "pattern": "^RSK-[0-9]{3}$" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "minLength": 8 },
    "status": {
      "enum": ["identified", "under_assessment", "pending_decision",
               "accepted", "accepted_with_controls", "mitigated",
               "transferred", "closed"]
    },
    "category": { "type": "string" },
    "owner": { "type": "string" },
    "description": { "type": "string", "minLength": 20 },
    "asset_refs": { "type": "array", "items": { "type": "string" } },
    "service_refs": { "type": "array", "items": { "type": "string" } },
    "assessment": { "$ref": "#/$defs/graded" },
    "threat_statements": { "type": "array", "items": { "type": "string" } },
    "existing_controls": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CTL-[0-9]{3}$" }
    },
    "mitigation_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "status"],
        "properties": {
          "action": { "type": "string", "minLength": 10 },
          "owner": { "type": "string" },
          "status": { "enum": ["planned", "in_progress", "done", "blocked"] },
          "target_date": { "$ref": "#/$defs/date" }
        }
      }
    },
    "residual": { "$ref": "#/$defs/graded" },
    "appetite": { "enum": ["within_appetite", "tolerated", "above_appetite"] },
    "appetite_note": { "type": "string" },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "decision_date", "accepted_by", "valid_until"],
      "properties": {
        "state": { "enum": ["accepted", "accepted_with_controls"] },
        "decision_date": { "$ref": "#/$defs/date" },
        "accepted_by": { "$ref": "#/$defs/person" },
        "rationale": { "type": "string" },
        "valid_until": { "$ref": "#/$defs/date" },
        "review_cadence": { "type": "string" },
        "monitoring": { "type": "array", "items": { "type": "string" } }
      }
    },
    "related": { "$ref": "#/$defs/related" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["accepted", "accepted_with_controls"] } } },
      "then": { "required": ["acceptance"] }
    }
  ],
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "graded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["likelihood", "impact", "score", "band"],
      "properties": {
        "likelihood": { "type": "integer", "minimum": 1, "maximum": 5 },
        "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
        "score": { "type": "integer", "minimum": 1, "maximum": 25 },
        "band": { "enum": ["low", "medium", "high", "critical"] }
      }
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policies":  { "type": "array", "items": { "type": "string" } },
        "exceptions":{ "type": "array", "items": { "type": "string" } },
        "risks":     { "type": "array", "items": { "type": "string" } },
        "standards": { "type": "array", "items": { "type": "string" } },
        "adrs":      { "type": "array", "items": { "type": "string" } },
        "controls":  { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
