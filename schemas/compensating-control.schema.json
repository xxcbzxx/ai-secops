{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-secops.dev/schemas/compensating-control.schema.json",
  "title": "AI-SecOps governance artifact — COMPENSATING CONTROL",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "id", "version", "title", "status",
               "owner", "description", "verification"],
  "properties": {
    "api_version": { "const": "ai-secops.gov/v1" },
    "kind": { "const": "compensating_control" },
    "id": { "type": "string", "pattern": "^CTL-[0-9]{3}$" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "minLength": 8 },
    "status": { "enum": ["draft", "active", "retired"] },
    "strength": { "enum": ["strong", "partial", "compensating", "weak"] },
    "owner": { "type": "string" },
    "description": { "type": "string", "minLength": 20 },
    "covers_risks": { "type": "array", "items": { "type": "string" } },
    "supports_exceptions": {
      "type": "array", "items": { "type": "string", "pattern": "^EX-[0-9]{3}$" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "verified_by", "verified_at"],
      "properties": {
        "method": { "type": "string", "minLength": 5 },
        "steps": { "type": "array", "items": { "type": "string" } },
        "verified_by": { "$ref": "#/$defs/person" },
        "verified_at": { "$ref": "#/$defs/date" },
        "evidence_ref": { "type": "string" },
        "evidence_sha256": { "type": "string" },
        "review_cadence": { "type": "string" },
        "next_review": { "$ref": "#/$defs/date" }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "related": { "$ref": "#/$defs/related" }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policies":  { "type": "array", "items": { "type": "string" } },
        "exceptions":{ "type": "array", "items": { "type": "string" } },
        "risks":     { "type": "array", "items": { "type": "string" } },
        "standards": { "type": "array", "items": { "type": "string" } },
        "adrs":      { "type": "array", "items": { "type": "string" } },
        "controls":  { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
